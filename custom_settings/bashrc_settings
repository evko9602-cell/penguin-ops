# ==========================================
# CUSTOM PROMPT - Ubuntu / Bash
# ==========================================

__custom_prompt() {
    local rc="$?"
    local color reset

    if [ "$(id -u)" -eq 0 ]; then
        color='\[\e[1;31m\]'   # ROOT - червен
        reset='\[\e[0m\]'
        PS1="${color}┌─(\[\e[1;33m\]\t${color})-(\[\e[1;36m\]\u${color})-(\[\e[1;35m\]\h${color})-(\[\e[1;34m\]\w${color})\n${color}└─ 🐧 ${reset}"
    else
        color='\[\e[1;32m\]'   # USER - зелен
        reset='\[\e[0m\]'
        PS1="${color}┌─(\[\e[1;33m\]\t${color})-(\[\e[1;36m\]\u${color})-(\[\e[1;35m\]\h${color})-(\[\e[1;34m\]\w${color})\n${color}└─ 🐧 ${reset}"
    fi
}

PROMPT_COMMAND=__custom_prompt

